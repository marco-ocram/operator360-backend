# Sample environment variables for opt360-portal-backend.
#
# These override whatever is in config.json (or, in stage/prod, replace it
# entirely — config.json doesn't need to exist at all if every var below is
# set; see config/config.go's Load()). Copy this file to .env, fill in real
# values, and source it before running the binary, or set these as a
# Kubernetes ConfigMap in stage/prod.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   go run main.go

# ── Server ────────────────────────────────────────────────────────────────
OPT360_SERVER_HOST=0.0.0.0
OPT360_SERVER_PORT=8080

# ── S3 ────────────────────────────────────────────────────────────────────
OPT360_S3_ENDPOINT=CHANGE_ME
OPT360_S3_BUCKET_NAME=CHANGE_ME
OPT360_S3_REGION=us-east-1
OPT360_S3_ACCESS_KEY=CHANGE_ME
OPT360_S3_SECRET_KEY=CHANGE_ME

# ── Databases ─────────────────────────────────────────────────────────────
# portal (strot_services) — auth users + anomaly reports
OPT360_DB_PORTAL_HOST=CHANGE_ME
OPT360_DB_PORTAL_PORT=3306
OPT360_DB_PORTAL_USER=CHANGE_ME
OPT360_DB_PORTAL_PASSWORD=CHANGE_ME
OPT360_DB_PORTAL_DATABASE=strot_services
OPT360_DB_PORTAL_MAX_OPEN_CONNS=10
OPT360_DB_PORTAL_MAX_IDLE_CONNS=2
OPT360_DB_PORTAL_CONN_MAX_LIFETIME_SECONDS=300

# uid (uidmasterv1_1) — UID/user identity data
OPT360_DB_UID_HOST=CHANGE_ME
OPT360_DB_UID_PORT=3306
OPT360_DB_UID_USER=CHANGE_ME
OPT360_DB_UID_PASSWORD=CHANGE_ME
OPT360_DB_UID_DATABASE=uidmasterv1_1
OPT360_DB_UID_MAX_OPEN_CONNS=15
OPT360_DB_UID_MAX_IDLE_CONNS=5
OPT360_DB_UID_CONN_MAX_LIFETIME_SECONDS=300

# NOTE: there is no OPT360_DB_OPT360_* here. The opt_master connection
# (operator360 database, on a different host than the other two) and its
# table reference ("operator360.opt_master") are hardcoded directly in
# main.go and at each query call site, not config-driven. See main.go's
# db.InitDB call for the pinned host/user/password — rotating them requires
# a code change + rebuild, unlike everything else in this file.

# ── Table locations ───────────────────────────────────────────────────────
# Each table's own database name AND table name, supplied independently of
# the connection settings above — the OPT360_DB_*_DATABASE vars control which
# database a connection opens into by default; these control what actually
# gets written into the SQL (e.g. "SELECT ... FROM <DATABASE>.<TABLE>"). They
# usually match but don't have to — set these if a given environment uses a
# different database and/or table name for the same logical data.
OPT360_TABLE_PORTAL_USERS_DATABASE=strot_services
OPT360_TABLE_PORTAL_USERS_TABLE=opt360_portal_users
OPT360_TABLE_MARK_ANOMALY_DATABASE=strot_services
OPT360_TABLE_MARK_ANOMALY_TABLE=mark_anomaly

# ── SID Store ─────────────────────────────────────────────────────────────
OPT360_SID_STORE_BASE_URL=http://localhost:9001
OPT360_SID_STORE_TIMEOUT_SECONDS=15

# ── ClickHouse (optional — leave host blank to skip) ─────────────────────
OPT360_CLICKHOUSE_HOST=
OPT360_CLICKHOUSE_PORT=8123
OPT360_CLICKHOUSE_DATABASE=
OPT360_CLICKHOUSE_USERNAME=
OPT360_CLICKHOUSE_PASSWORD=
OPT360_CLICKHOUSE_SECURE=false

# ── Trino (optional, currently unused by any query) ───────────────────────
OPT360_TRINO_HOST=
OPT360_TRINO_PORT=8080
OPT360_TRINO_CATALOG=
OPT360_TRINO_SCHEMA=
OPT360_TRINO_USERNAME=
